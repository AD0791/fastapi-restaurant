PORT=8000
ENVIRONMENT=development             # decides validation strictness and trusted origins; Settings has no default, so a missing value fails to boot instead of guessing
API_BASE_URL=http://localhost:8000  # echoed back by GET /config; a wrong value misleads a reader, nothing else breaks
LOG_LEVEL=info   # minimum severity structlog emits; an unrecognized value surfaces when logging is configured, not at Settings() construction
DATABASE_URL=mysql+asyncmy://root:devroot@mysql:3306/fastapi_restaurant   # the password and database name here must match MYSQL_ROOT_PASSWORD and MYSQL_DATABASE below; a mismatch fails as an authentication error, not a config error
DATABASE_POOL_SIZE=5   # bounded 1-20 by Settings; a stray extra zero opens far more connections than intended, a missing one opens none
DATABASE_SSL_CA_PATH=   # empty in local development; the deploy story points this at Aiven's CA bundle
MYSQL_ROOT_PASSWORD=devroot   # read by the mysql image's own entrypoint, not by Settings; must match the password embedded in DATABASE_URL above
MYSQL_DATABASE=fastapi_restaurant   # read by the mysql image's own entrypoint to create the database on first boot; must match the database name in DATABASE_URL
